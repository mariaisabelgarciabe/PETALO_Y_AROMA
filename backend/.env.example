
# PÉTALO & AROMA — Backend
# Configuración de variables de entorno (ejemplo).
# Copia este archivo a .env y completa con tus valores reales.
# No incluyas credenciales en este archivo ni en el código fuente.

# Servidor FastAPI
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Base de datos SQL Server (PyODBC)
# Configuración local de ejemplo
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=PETALO_AROMA
DB_DRIVER="ODBC Driver 17 for SQL Server"
DB_TRUSTED_CONNECTION=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Alternativa: cadena de conexión completa
# DB_CONNECTION_STRING="DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=PETALO_AROMA;Trusted_Connection=yes;TrustServerCertificate=yes"

# Para autenticación SQL Server (en lugar de Windows Auth),
# descomenta y completa con tus propias credenciales:
# DB_USER=tuUsuario
# DB_PASSWORD=tuContraseña
